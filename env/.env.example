# MS-GPT external paths. Copy to repo root as `.env`, edit, then:
#   set -a; source .env; set +a
#
# Repository-local defaults can be overridden with these variables.

# --- Released weights --------------------------------------------------------
# MIST spectrum->fingerprint encoders (one per benchmark; never cross-used).
export MS_GPT_MIST_MASSSPECGYM_CKPT="checkpoints/mist/mist_massspecgym.pt"
export MS_GPT_MIST_NPLIB1_CKPT="checkpoints/mist/mist_nplib1.pt"
# Original SAFE-GPT snapshot used for offline tokenization and warm-starting.
export MS_GPT_SAFE_GPT_CKPT="checkpoints/safe_gpt_base"

# --- Included benchmark datasets --------------------------------------------
# MassSpecGym spectra, organized as parquet dirs per split: $MS_GPT_MASSSPECGYM_DATA/{train,val,test}
export MS_GPT_MASSSPECGYM_DATA="data/benchmarks/massspecgym"
# MassSpecGym validation/test label TSVs used by MLM-only evaluation.
export MS_GPT_MASSSPECGYM_LABELS="data/benchmarks/massspecgym/labels"
export MS_GPT_NPLIB1_DATA="data/benchmarks/nplib1"

# --- Conditional-MLM pretraining corpus (only needed to reproduce pretraining)
# Only needed to rebuild the included processed 100M corpus from its raw source.
export MS_GPT_SAFE_GPT_RAW="/path/to/safe_gpt_raw"

# --- Conda env bin used by launch/*.sh (optional override) -------------------
# export MS_GPT_ENV_BIN="/opt/conda/envs/ms_gpt/bin"
